  "type": "module",
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@cypress/vite-dev-server": "^7.3.2",
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.5",
    "cypress": "^15.15.0",
    "cypress-plugin-tab": "^2.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^14.0.0",
    "jsdom": "^27.0.1",
    "start-server-and-test": "^2.1.5",
    "typescript": "^5.2.0",
    "typescript-eslint": "^8.59.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@asamuzakjp/css-color": {
      "@csstools/css-calc": "^3.0.0"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:unit": "vitest --run tests/unit",
    "test:unit:ci": "vitest --run --coverage tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:integration:ci": "vitest --run --coverage tests/integration",
    "cypress:open": "cypress open",
  "cypress:run": "cypress run",
  "dev:cypress": "vite --config vite.config.cypress.ts",
  "test:e2e": "start-server-and-test dev:cypress http://localhost:5173 cypress:open",
  "test:e2e:ci": "start-server-and-test dev:cypress http://localhost:5173 cypress:run"
}
}
